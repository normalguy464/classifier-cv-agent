CLASSIFIER_POSTGRES_DB=replace-with-local-runtime-database-name
CLASSIFIER_POSTGRES_TEST_DB=replace-with-local-test-database-name
CLASSIFIER_POSTGRES_USER=replace-with-local-database-user
CLASSIFIER_POSTGRES_PASSWORD=replace-with-local-database-password
CLASSIFIER_POSTGRES_PORT=55432
CLASSIFIER_API_KEY=replace-with-local-api-key
CLASSIFIER_STORAGE_BACKEND=postgres
CLASSIFIER_DATABASE_URL=postgresql+psycopg://replace-with-local-database-user:replace-with-local-database-password@127.0.0.1:55432/replace-with-local-runtime-database-name
CLASSIFIER_TEST_DATABASE_URL=postgresql+psycopg://replace-with-local-database-user:replace-with-local-database-password@127.0.0.1:55432/replace-with-local-test-database-name
CLASSIFIER_CONFIG_DIRECTORY=configs/runtime/five_role_v2
CLASSIFIER_EMBEDDING_ADAPTER=sentence_transformers
CLASSIFIER_LLM_ADAPTER=deterministic_fake
CLASSIFIER_LLM_PROVIDER=deterministic_fake
CLASSIFIER_LLM_MODEL=deterministic-evidence-scorer-v1
CLASSIFIER_LLM_API_KEY=replace-only-when-using-a-real-provider
CLASSIFIER_LLM_BASE_URL=replace-only-when-using-an-openai-compatible-provider
CLASSIFIER_REQUEST_TIMEOUT_SECONDS=30
